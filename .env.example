APP_SOCIAL_NAME=MirandaClin
APP_ENV=development
APP_NAME=mirandaclin
APP_PORT=8080

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_ENABLED=true

# URL base do frontend — usada para montar o link do convite no email
WEB_PUBLIC_DNS=http://localhost:4200
WEB_VERIFY_EMAIL_URL=/convite/aceitar

DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=secret
DB_NAME=mirandaclin
DB_SSLMODE=disable

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ISSUER=https://accounts.google.com
JWT_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
JWT_SECRET=troque-por-segredo-forte-em-producao

# Email — se SMTP_HOST estiver vazio usa noop (imprime no stdout)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@mirandaclin.com.br
SMTP_PASS=senha-app-gmail
SMTP_FROM=no-reply@mirandaclin.com.br

GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
